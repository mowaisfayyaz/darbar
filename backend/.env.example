# Supabase Configuration
SUPABASE_URL="your_supabase_url_here"
SUPABASE_KEY="your_supabase_anon_key_here"

# ----------------- TIER 1: OPENCODE ZEN / MINIMAX CONFIG -----------------
MINIMAX_API_KEY="your_minimax_api_key_here"
MINIMAX_MODEL_NAME=minimax-m2.5-free

# ----------------- TIER 2: GEMINI FALLBACK CONFIG -----------------
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL_NAME=gemini-1.5-flash

# ----------------- TIER 3: GROQ FALLBACK CONFIG -----------------
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL_NAME=llama3-70b-8192

# ----------------- EXTERNAL APIS & DISPATCH -----------------
# Google Maps API
GMAPS_API_KEY="your_google_maps_api_key_here"

# Twilio Configuration
TWILIO_ACCOUNT_SID="your_twilio_account_sid_here"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
TWILIO_FROM_PHONE="your_twilio_phone_number_here"

# Gmail API Credentials (SMTP Fallback)
EMAIL_HOST_USER="your_email@gmail.com"
EMAIL_HOST_PASSWORD="your_app_password_here"

# Apify Google Maps API
APIFY_API_TOKEN="your_apify_api_token_here"

# Django Secret Key
SECRET_KEY="replace-this-with-a-secure-secret-key-for-django"
DEBUG="True"

# Postgres Connection String (from Supabase Database Settings)
DATABASE_URL="postgresql://postgres.[db-id]:[db-password]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Google OAuth 2.0 Credentials (Get these from Google Cloud Console)
GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
GOOGLE_REDIRECT_URI="http://127.0.0.1:8000/api/auth/google/callback/"
